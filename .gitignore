# ==========================================
# 1. TERRAFORM
# ==========================================
# Local directory for managing plugins and modules
.terraform/

# Local state files (Crucial safety risk - DO NOT COMMIT)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# 2. NODE.JS & REACT (Vite)
# ==========================================
# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build outputs
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
eslintcache

# Local environment secrets
frontend/radar-map-ui/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 3. PYTHON
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# ==========================================
# 4. GO (Golang)
# ==========================================
# Compiled binaries
bootstrap
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ==========================================
# 5. PROJECT SPECIFIC ARTIFACTS
# ==========================================
# Ignore the generated deployment zip bundles
handlers/*.zip